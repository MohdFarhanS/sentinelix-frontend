# Copy this file to .env.local and fill in the real values.
# .env.local itself is gitignored — never commit real secrets.

# Base URL of the Go backend API (sentinelix-backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Must match JWT_SECRET in the backend's .env — used to verify JWT signatures
# in middleware.ts (route protection) without a round-trip to the API.
# Server-side only: NOT prefixed with NEXT_PUBLIC_, so it is never bundled
# into client-side JS.
JWT_SECRET=change-me-to-a-long-random-secret
